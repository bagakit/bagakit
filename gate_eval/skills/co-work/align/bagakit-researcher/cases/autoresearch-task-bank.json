{
  "schema": "bagakit.eval-dataset/v1",
  "dataset_id": "bagakit-researcher-autoresearch-v1",
  "title": "Researcher Auto Research Capability Task Bank",
  "description": "Sanitized fixed cases for paired researcher strategy experiments. These cases define routing and evidence expectations; they do not contain semantic gold answers yet.",
  "item_schema": "researcher-autoresearch-case/v1",
  "build": {
    "baseline_split": "baseline",
    "holdout_split": "holdout",
    "holdout_ratio": 0.25,
    "holdout_tags": ["holdout"],
    "seed": "researcher-autoresearch-v1"
  },
  "items": [
    {
      "id": "lookup-direct-source",
      "skill_id": "bagakit-researcher",
      "prompt": "Find one authoritative answer to a narrow factual question and state the uncertainty boundary.",
      "expected_outcome": "One source-bound answer with a direct source and an explicit limitation.",
      "notes_for_human_review": "Check that the agent does not broaden a lookup into an unnecessary survey.",
      "tags": ["lookup", "narrow", "public"],
      "dimensions": ["grounding", "drift", "durable-value"],
      "goal_dimensions": ["precision", "speed", "cost"],
      "success_evidence": ["one direct source ref", "one bounded answer", "one limitation"],
      "guard_ids": ["no-unsupported-claim", "no-scope-drift"],
      "privacy": {"class": "public", "sanitized": true, "raw_transcript_included": false},
      "grader": {"type": "state", "rubric_id": "record-contract-v1", "calibration_status": "not_required", "transfer_limit": "record-level only"},
      "lifecycle": {"stage": "capability"},
      "trials": {"count": 1, "min_pass_rate": 1.0},
      "split": "baseline",
      "metadata": {"task_shape": "lookup", "gold_source_classes": ["primary"], "must_find_claims": 1, "counterexamples": 0, "budget": "one source route; bounded lookup"}
    },
    {
      "id": "survey-route-map",
      "skill_id": "bagakit-researcher",
      "prompt": "Survey a field before broad retrieval: identify source classes, competing terminology, blind spots, and a bounded route plan.",
      "expected_outcome": "A survey packet with a source-landscape map, route coverage, and stop condition.",
      "notes_for_human_review": "Do not reward a long source list if it does not change the route plan.",
      "tags": ["survey", "coverage", "public"],
      "dimensions": ["coverage", "drift", "validity"],
      "goal_dimensions": ["coverage", "depth", "cost"],
      "success_evidence": ["source classes", "known gaps", "route plan", "stop condition"],
      "guard_ids": ["coverage-carrier", "bounded-stop"],
      "privacy": {"class": "public", "sanitized": true, "raw_transcript_included": false},
      "grader": {"type": "state", "rubric_id": "record-contract-v1", "calibration_status": "not_required", "transfer_limit": "record-level only"},
      "lifecycle": {"stage": "capability"},
      "trials": {"count": 1, "min_pass_rate": 1.0},
      "split": "baseline",
      "metadata": {"task_shape": "survey", "gold_source_classes": ["primary", "benchmark", "counterevidence"], "must_find_claims": 3, "counterexamples": 1, "budget": "three source routes; bounded survey"}
    },
    {
      "id": "bounded-evidence-pass",
      "skill_id": "bagakit-researcher",
      "prompt": "Run a bounded evidence pass over a clear question, preserving source cards, summaries, one claim, and an honest stop receipt.",
      "expected_outcome": "A reusable source-bound artifact with a measured resource receipt or explicit unknowns.",
      "notes_for_human_review": "Activity volume is not an artifact delta.",
      "tags": ["bounded-pass", "resource", "public"],
      "dimensions": ["grounding", "efficiency", "durable-value"],
      "goal_dimensions": ["precision", "speed", "cost"],
      "success_evidence": ["source card", "summary", "claim", "resource receipt"],
      "guard_ids": ["artifact-delta", "resource-unknown-explicit"],
      "privacy": {"class": "public", "sanitized": true, "raw_transcript_included": false},
      "grader": {"type": "state", "rubric_id": "record-contract-v1", "calibration_status": "not_required", "transfer_limit": "record-level only"},
      "lifecycle": {"stage": "capability"},
      "trials": {"count": 1, "min_pass_rate": 1.0},
      "split": "baseline",
      "metadata": {"task_shape": "bounded-pass", "gold_source_classes": ["primary"], "must_find_claims": 1, "counterexamples": 1, "budget": "one bounded pass"}
    },
    {
      "id": "parallel-independent-routes",
      "skill_id": "bagakit-researcher",
      "prompt": "Research the same decision through independent source routes, then merge the routes without duplicating context or hiding disagreement.",
      "expected_outcome": "A parallel-pass artifact with explicit coverage refs, independent route summaries, and a merge decision.",
      "notes_for_human_review": "Parallelism is useful only when routes are independent and information is preserved.",
      "tags": ["parallel-pass", "cross-source", "public"],
      "dimensions": ["coverage", "efficiency", "durable-value"],
      "goal_dimensions": ["coverage", "insight", "cost"],
      "success_evidence": ["independent routes", "coverage refs", "merge decision", "no duplicate context"],
      "guard_ids": ["coverage-carrier", "no-context-replay"],
      "privacy": {"class": "public", "sanitized": true, "raw_transcript_included": false},
      "grader": {"type": "state", "rubric_id": "record-contract-v1", "calibration_status": "not_required", "transfer_limit": "record-level only"},
      "lifecycle": {"stage": "capability"},
      "trials": {"count": 1, "min_pass_rate": 1.0},
      "split": "baseline",
      "metadata": {"task_shape": "parallel-pass", "gold_source_classes": ["primary", "operations"], "must_find_claims": 2, "counterexamples": 1, "budget": "two independent routes"}
    },
    {
      "id": "audit-gaming-and-drift",
      "skill_id": "bagakit-researcher",
      "prompt": "Audit a previous research session for unsupported claims, activity-only closeout, scope drift, and metric gaming.",
      "expected_outcome": "A warning-first audit with defects, evidence refs, and a bounded repair action.",
      "notes_for_human_review": "A clean-looking report is not evidence that the process was clean.",
      "tags": ["audit", "adversarial", "public"],
      "dimensions": ["drift", "validity", "grounding"],
      "goal_dimensions": ["precision", "validity", "cost"],
      "success_evidence": ["defect list", "evidence refs", "non-proof boundary", "repair action"],
      "guard_ids": ["no-activity-only-value", "no-rubric-gaming"],
      "privacy": {"class": "public", "sanitized": true, "raw_transcript_included": false},
      "grader": {"type": "state", "rubric_id": "record-contract-v1", "calibration_status": "not_required", "transfer_limit": "record-level only"},
      "lifecycle": {"stage": "capability"},
      "trials": {"count": 1, "min_pass_rate": 1.0},
      "split": "baseline",
      "metadata": {"task_shape": "audit", "gold_source_classes": ["session-trace", "metric-methodology"], "must_find_claims": 2, "counterexamples": 2, "budget": "one audit pass"}
    },
    {
      "id": "synthesis-conflict-bridge",
      "skill_id": "bagakit-researcher",
      "prompt": "Synthesize conflicting evidence, explain the disagreement, and propose one novel cross-source bridge that changes a decision.",
      "expected_outcome": "A synthesis with claim checkpoints, counterevidence, a supported bridge insight, and a decision ref.",
      "notes_for_human_review": "Do not count a merely surprising sentence as insight; it must be novel, useful, and supported.",
      "tags": ["synthesis", "conflict", "insight", "holdout"],
      "dimensions": ["coverage", "grounding", "durable-value"],
      "goal_dimensions": ["insight", "depth", "precision"],
      "success_evidence": ["conflict type", "claim checkpoints", "counterevidence", "supported bridge", "decision ref"],
      "guard_ids": ["decision-carrier", "insight-support", "conflict-explicit"],
      "privacy": {"class": "public", "sanitized": true, "raw_transcript_included": false},
      "grader": {"type": "state", "rubric_id": "record-contract-v1", "calibration_status": "not_required", "transfer_limit": "record-level only"},
      "lifecycle": {"stage": "capability"},
      "trials": {"count": 1, "min_pass_rate": 1.0},
      "split": "holdout",
      "metadata": {"task_shape": "synthesis", "gold_source_classes": ["primary", "counterevidence", "practice"], "must_find_claims": 3, "counterexamples": 2, "budget": "three evidence routes plus synthesis"}
    },
    {
      "id": "handoff-actionability",
      "skill_id": "bagakit-researcher",
      "prompt": "Turn a bounded research result into a downstream handoff with a decision, unknowns, next action, and acceptance condition.",
      "expected_outcome": "A handoff artifact that a downstream owner can accept, reject, or request more evidence from.",
      "notes_for_human_review": "A polished report without an actionable decision is incomplete.",
      "tags": ["handoff", "actionability", "holdout"],
      "dimensions": ["durable-value", "validity", "drift"],
      "goal_dimensions": ["actionability", "precision", "cost"],
      "success_evidence": ["decision ref", "unknowns", "next action", "acceptance condition"],
      "guard_ids": ["decision-carrier", "unknown-explicit", "handoff-actionable"],
      "privacy": {"class": "public", "sanitized": true, "raw_transcript_included": false},
      "grader": {"type": "state", "rubric_id": "record-contract-v1", "calibration_status": "not_required", "transfer_limit": "record-level only"},
      "lifecycle": {"stage": "capability"},
      "trials": {"count": 1, "min_pass_rate": 1.0},
      "split": "holdout",
      "metadata": {"task_shape": "handoff", "gold_source_classes": ["artifact", "decision"], "must_find_claims": 1, "counterexamples": 1, "budget": "one handoff pass"}
    },
    {
      "id": "experiment-honest-stop",
      "skill_id": "bagakit-researcher",
      "prompt": "Run a small research experiment, detect when new evidence is not arriving, and stop honestly without inventing a result.",
      "expected_outcome": "An experiment receipt with explicit unknowns or a no-new-evidence stop, plus the next bounded test.",
      "notes_for_human_review": "Stopping without a result can be correct when the stop receipt is inspectable.",
      "tags": ["experiment", "unknown-stop", "public"],
      "dimensions": ["efficiency", "validity", "durable-value"],
      "goal_dimensions": ["speed", "cost", "validity"],
      "success_evidence": ["stop reason", "resource receipt", "unknowns", "next test"],
      "guard_ids": ["honest-stop", "unknown-explicit", "no-fabricated-result"],
      "privacy": {"class": "public", "sanitized": true, "raw_transcript_included": false},
      "grader": {"type": "state", "rubric_id": "record-contract-v1", "calibration_status": "not_required", "transfer_limit": "record-level only"},
      "lifecycle": {"stage": "capability"},
      "trials": {"count": 1, "min_pass_rate": 1.0},
      "split": "baseline",
      "metadata": {"task_shape": "experiment", "gold_source_classes": ["primary", "experiment"], "must_find_claims": 1, "counterexamples": 1, "budget": "fixed small experiment budget"}
    }
  ]
}
