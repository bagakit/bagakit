{
  "id": "link-behavior",
  "fixture": "link-behavior",
  "title": "Link Behavior",
  "summary": "Measure link creation, idempotence, conflict handling, and stale canonical symlink refresh.",
  "focus": [
    "link-create",
    "link-idempotence",
    "link-force-conflict",
    "link-stale-canonical-refresh"
  ],
  "probes": [
    {
      "id": "link-solo-first-run",
      "title": "Create a symlink for a unique skill-id selector",
      "argv": [
        "link",
        "--selector",
        "solo",
        "--dest",
        "linked",
        "--json"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutJson": {
          "selector": "solo",
          "kind": "skill-id",
          "destination": "linked",
          "results": [
            {
              "selector": "human-improvement/solo",
              "status": "linked",
              "destinationPath": "linked/solo",
              "sourcePath": "skills/human-improvement/solo"
            }
          ]
        }
      },
      "assertFs": [
        {
          "kind": "symlink",
          "path": "linked/solo",
          "resolvesTo": "skills/human-improvement/solo"
        }
      ]
    },
    {
      "id": "link-solo-second-run",
      "title": "Keep the same link unchanged on the second run",
      "argv": [
        "link",
        "--selector",
        "solo",
        "--dest",
        "linked",
        "--json"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutJson": {
          "selector": "solo",
          "kind": "skill-id",
          "destination": "linked",
          "results": [
            {
              "selector": "human-improvement/solo",
              "status": "unchanged",
              "destinationPath": "linked/solo",
              "sourcePath": "skills/human-improvement/solo"
            }
          ]
        }
      },
      "assertFs": [
        {
          "kind": "symlink",
          "path": "linked/solo",
          "resolvesTo": "skills/human-improvement/solo"
        }
      ]
    },
    {
      "id": "reject-alpha-conflict-without-force",
      "title": "Reject a conflicting destination path without force",
      "setup": [
        {
          "type": "write_file",
          "path": "linked/alpha",
          "content": "occupied"
        }
      ],
      "argv": [
        "link",
        "--selector",
        "harness/alpha",
        "--dest",
        "linked",
        "--json"
      ],
      "expect": {
        "exitCode": 1,
        "stderrContains": [
          "bagakit-skill: link operation has protected path conflicts:",
          "- linked/alpha is not a symbolic link; refusing to replace it"
        ]
      }
    },
    {
      "id": "force-replace-alpha-conflict",
      "title": "Replace a conflicting destination path with force",
      "setup": [
        {
          "type": "symlink",
          "path": "linked-force/alpha",
          "mode": "repo-root-absolute",
          "target": "skills/human-improvement/solo",
          "linkType": "dir"
        }
      ],
      "argv": [
        "link",
        "--selector",
        "harness/alpha",
        "--dest",
        "linked-force",
        "--force",
        "--json"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutJson": {
          "selector": "harness/alpha",
          "kind": "qualified",
          "destination": "linked-force",
          "results": [
            {
              "selector": "harness/alpha",
              "status": "linked",
              "destinationPath": "linked-force/alpha",
              "sourcePath": "skills/harness/alpha"
            }
          ]
        }
      },
      "assertFs": [
        {
          "kind": "symlink",
          "path": "linked-force/alpha",
          "resolvesTo": "skills/harness/alpha"
        }
      ]
    },
    {
      "id": "refresh-stale-same-repo-skill-link",
      "title": "Refresh a stale same-repo skill-id symlink without force",
      "setup": [
        {
          "type": "symlink",
          "path": "linked/stale",
          "mode": "repo-root-absolute",
          "target": "skills/swe/stale",
          "linkType": "dir"
        }
      ],
      "argv": [
        "link",
        "--selector",
        "stale",
        "--dest",
        "linked",
        "--json"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutJson": {
          "selector": "stale",
          "kind": "skill-id",
          "destination": "linked",
          "results": [
            {
              "selector": "paperwork/stale",
              "status": "linked",
              "destinationPath": "linked/stale",
              "sourcePath": "skills/paperwork/stale"
            }
          ]
        }
      },
      "assertFs": [
        {
          "kind": "symlink",
          "path": "linked/stale",
          "resolvesTo": "skills/paperwork/stale"
        }
      ]
    }
  ]
}
